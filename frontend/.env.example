# Get these from your Supabase project: Settings -> API
# VITE_SUPABASE_URL is the "Project URL"
# VITE_SUPABASE_ANON_KEY is the "anon public" key (NOT service_role)
#
# Safe to be visible in the browser — Row Level Security policies on
# each table are what actually protects the data, not this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The backend's live URL (Render) -- Mock Interview calls it directly
# since it's a different domain from this frontend. No secret here,
# just a public URL.
VITE_API_BASE_URL=https://preppilot-augq.onrender.com
