# This file is a TEMPLATE. It lists which secrets the app needs, with no
# real values. Copy it to a file named ".env" and fill in your real keys
# there. ".env" is listed in .gitignore, so it never gets uploaded to GitHub.

# Gemini API key, from Google AI Studio
GEMINI_API_KEY=

# NVIDIA build.nvidia.com API key
NVIDIA_API_KEY=

# Groq API key, from console.groq.com
GROQ_API_KEY=

# Supabase project URL and keys, from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
